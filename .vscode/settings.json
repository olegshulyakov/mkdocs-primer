{
  // site/ is seven locales of generated HTML and node_modules/ is the CSS
  // vendoring toolchain; both bury the sources they were built from.
  "search.exclude": {
    "dist": true,
    "node_modules": true,
    "site": true
  },
  // Where this project's own instructions put the virtualenv. It is only the
  // starting guess — pick another interpreter from the status bar and the tasks
  // follow it.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}
