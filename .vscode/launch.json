{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open the demo site",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8000/mkdocs-primer/",
      "preLaunchTask": "Serve the demo site",
      "pathMapping": {
        "/mkdocs-primer/css": "${workspaceFolder}/mkdocs_primer/css",
        "/mkdocs-primer/js": "${workspaceFolder}/mkdocs_primer/js"
      }
    },
    {
      "name": "Open the demo site (narrow window)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8000/mkdocs-primer/",
      "preLaunchTask": "Serve the demo site",
      "runtimeArgs": ["--window-size=760,900"],
      "pathMapping": {
        "/mkdocs-primer/css": "${workspaceFolder}/mkdocs_primer/css",
        "/mkdocs-primer/js": "${workspaceFolder}/mkdocs_primer/js"
      }
    }
  ]
}
